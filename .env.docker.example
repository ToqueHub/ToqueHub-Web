POSTGRES_DB=toquehub
POSTGRES_USER=toquehub
POSTGRES_PASSWORD=toquehub

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
BACKUP_CLOUD_ENCRYPTION_KEY=replace-with-a-32-byte-minimum-random-secret
TOQUEHUB_UPDATER_SECRET=replace-with-a-long-random-updater-secret
TOQUEHUB_REMOTE_AGENT_SECRET=replace-with-a-long-random-remote-agent-secret
TOQUEHUB_REMOTE_AGENT_URL=http://host.docker.internal:3101

TOQUEHUB_RELEASE_REPO=ToqueHub/ToqueHub-Web
TOQUEHUB_GITHUB_TOKEN=
TOQUEHUB_IMAGE_REGISTRY=ghcr.io/toquehub
TOQUEHUB_IMAGE_TAG=latest
TOQUEHUB_HTTP_PORT=8080
TOQUEHUB_WEB_URL=http://localhost:8080
ZIGBEE2MQTT_HTTP_PORT=8081
MQTT_PORT=1883
TZ=Europe/Paris

TOQUEHUB_TAILSCALE_ENABLED=true
TOQUEHUB_TAILSCALE_AUTHKEY=
TOQUEHUB_TAILSCALE_HOSTNAME=toquehub
TOQUEHUB_TAILSCALE_INSTALLED=false
TOQUEHUB_TAILSCALE_IP=
TOQUEHUB_REMOTE_ACCESS_URL=

TOQUEHUB_DISCOVERY_ENABLED=true
TOQUEHUB_DISCOVERY_NAME="Cuisine Centrale"
TOQUEHUB_DISCOVERY_ORGANIZATION="Cuisine Centrale"
TOQUEHUB_DISCOVERY_HOST=
TOQUEHUB_DISCOVERY_PORT=8080
TOQUEHUB_DISCOVERY_HTTPS=false

MQTT_USERNAME=
MQTT_PASSWORD=
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
ZIGBEE2MQTT_FRONTEND_URL=http://localhost:8081
ZIGBEE_ADAPTER_PATH=/dev/ttyUSB0
ZIGBEE_ADAPTER_TYPE=zstack

HACCP_SENSOR_OFFLINE_AFTER_MINUTES=30
HACCP_PAIRING_DURATION_SECONDS=180
