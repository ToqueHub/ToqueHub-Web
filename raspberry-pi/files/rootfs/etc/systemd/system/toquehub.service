[Unit]
Description=ToqueHub Docker appliance
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/toquehub
EnvironmentFile=/etc/toquehub/toquehub.env
ExecStart=/usr/bin/docker compose --env-file /etc/toquehub/toquehub.env -f /opt/toquehub/docker-compose.pi.yml up -d
ExecStop=/usr/bin/docker compose --env-file /etc/toquehub/toquehub.env -f /opt/toquehub/docker-compose.pi.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
