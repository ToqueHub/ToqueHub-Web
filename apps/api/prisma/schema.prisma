  hrTimeAccounts                  HrTimeAccount[]
  hrTimeAccountTransactions       HrTimeAccountTransaction[]
  planningAttendanceEntries       PlanningAttendanceEntry[]
  hrEntitlementCatalogItems       HrEntitlementCatalogItem[]
  hrEntitlementRules              HrEntitlementRule[]
  hrEmployeeEntitlements          HrEmployeeEntitlement[]
