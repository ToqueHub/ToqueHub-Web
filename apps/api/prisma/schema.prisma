  messages           SupportRelayMessage[]
  events             SupportRelayEvent[]

  @@unique([installationId, localTicketId])
  @@index([telegramTopicId])
  @@index([expiresAt])
  @@map("support_relay_tickets")
}

model SupportRelayMessage {
  id                String             @id @default(uuid()) @db.Uuid
  ticketId          String             @db.Uuid
  localMessageId    String?
  telegramMessageId String?
  author            String
  content           String             @db.Text
  payload           Json?
  createdAt         DateTime           @default(now())
  ticket            SupportRelayTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, localMessageId])
  @@unique([ticketId, telegramMessageId])
  @@map("support_relay_messages")
}

model SupportRelayEvent {
  id          String             @id @default(uuid()) @db.Uuid
  ticketId    String             @db.Uuid
  eventKey    String             @unique
  payload     Json
  deliveredAt DateTime?
  createdAt   DateTime           @default(now())
