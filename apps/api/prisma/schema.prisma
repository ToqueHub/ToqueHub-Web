// Ces tables appartiennent au déploiement central apps/support-relay. Elles restent
// dans le schéma partagé afin que le relais et les installations utilisent le même client Prisma.
model SupportRelayInstallation {
  id         String               @id @default(uuid()) @db.Uuid
  instanceId String               @unique
  secret     String               @db.Text
  blockedAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
