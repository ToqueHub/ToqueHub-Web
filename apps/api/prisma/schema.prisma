model TechnicalSheet {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @db.Uuid
  categoryId             String?              @db.Uuid
  sourceTechnicalSheetId String?              @db.Uuid
  name                   String
  description            String?              @db.Text
  photoUrl               String?              @db.Text
  photoDataUrl           String?              @db.Text
  referencePortions      Decimal              @default(1) @db.Decimal(12, 3)
  preparationTimeMinutes Int?                 @default(0)
  cookingTimeMinutes     Int?                 @default(0)
  totalTimeMinutes       Int?                 @default(0)
  status                 TechnicalSheetStatus @default(DRAFT)
  totalCost              Decimal              @default(0) @db.Decimal(12, 4)
  costPerPortion         Decimal              @default(0) @db.Decimal(12, 4)
  costPerKg              Decimal?             @db.Decimal(12, 4)
  costPerLiter           Decimal?             @db.Decimal(12, 4)
  hasNonCalculableLines  Boolean              @default(false)
  lastCostCalculationAt  DateTime?
  isArchived             Boolean              @default(false)
  archivedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                TechnicalSheetCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceTechnicalSheet    TechnicalSheet?              @relation("TechnicalSheetDuplication", fields: [sourceTechnicalSheetId], references: [id], onDelete: SetNull)
  duplicates              TechnicalSheet[]             @relation("TechnicalSheetDuplication")
  ingredients             TechnicalSheetIngredient[]
  steps                   TechnicalSheetStep[]
  costSnapshots           TechnicalSheetCostSnapshot[]
  simulations             TechnicalSheetSimulation[]
  exports                 TechnicalSheetExport[]
  history                 TechnicalSheetHistory[]
  productionOrders        ProductionOrder[]
  menuItems               MenuItem[]
  menuVariantReplacements MenuVariantReplacement[]
  menuCycleItems          MenuCycleItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([categoryId])
  @@index([status])
  @@index([isArchived])
  @@index([updatedAt])
  @@map("technical_sheets")
}

model TechnicalSheetIngredient {
