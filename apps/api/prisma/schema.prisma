  updatedAt       DateTime  @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("HaccpOilSessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  equipment     HaccpOilEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  photoDocument Document?         @relation(fields: [photoDocumentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, clientId])
  @@index([organizationId])
  @@index([createdById])
  @@index([equipmentId])
  @@index([sessionDate])
  @@index([action])
  @@map("haccp_oil_sessions")
}

