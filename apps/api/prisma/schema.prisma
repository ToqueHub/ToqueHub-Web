  nonces     SupportRelayNonce[]

  @@map("support_relay_installations")
}

model SupportRelayNonce {
  id             String                   @id @default(uuid()) @db.Uuid
  installationId String                   @db.Uuid
  nonce          String
  expiresAt      DateTime
  createdAt      DateTime                 @default(now())
  installation   SupportRelayInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, nonce])
  @@index([expiresAt])
  @@map("support_relay_nonces")
}

model SupportRelayTicket {
  id                 String                   @id @default(uuid()) @db.Uuid
  installationId     String                   @db.Uuid
  localTicketId      String
  telegramTopicId    String?
  status             String                   @default("OPEN")
