model SystemSetting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  username       String?    @unique
  email          String     @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  status         UserStatus @default(ACTIVE)
  isActive       Boolean    @default(true)
  isPrimaryAdmin Boolean    @default(false)
  lastLoginAt    DateTime?
  organizationId String?    @db.Uuid
  roleId         String     @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization                       Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                               Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  movements                          StockMovement[]                @relation("StockMovementCreatedBy")
  uploadedDocuments                  Document[]                     @relation("DocumentUploadedBy")
  createdStockReceptions             StockReception[]               @relation("StockReceptionCreatedBy")
  inventories                        Inventory[]                    @relation("InventoryCreatedBy")
  auditLogs                          AuditLog[]
  rnmFavorites                       RnmProductFavorite[]
  hrEmployee                         HrEmployee?
  hrHistory                          HrEmployeeHistory[]
  createdHrContracts                 HrEmploymentContract[]         @relation("HrContractCreatedBy")
  createdHrCompensations             HrEmployeeCompensation[]       @relation("HrCompensationCreatedBy")
  completedHrSalaryReviews           HrSalaryReview[]               @relation("HrSalaryReviewCompletedBy")
  createdHrDocuments                 HrDocument[]                   @relation("HrDocumentCreatedBy")
  hrRotationAssignments              HrRotationAssignment[]
  validatedHrAbsences                HrAbsence[]                    @relation("HrAbsenceValidator")
  createdPlanningAssignments         PlanningAssignment[]           @relation("PlanningAssignmentCreatedBy")
  updatedPlanningAssignments         PlanningAssignment[]           @relation("PlanningAssignmentUpdatedBy")
  requestedPlanningReplacements      PlanningReplacement[]          @relation("PlanningReplacementRequestedBy")
  acceptedPlanningReplacements       PlanningReplacement[]          @relation("PlanningReplacementAcceptedBy")
  createdPlanningNeeds               PlanningOperationalNeed[]      @relation("PlanningNeedCreatedBy")
  createdPlanningTemplates           PlanningTemplate[]             @relation("PlanningTemplateCreatedBy")
  appliedPlanningTemplates           PlanningTemplateApplication[]  @relation("PlanningTemplateAppliedBy")
  launchedPlanningGenerations        PlanningGeneration[]           @relation("PlanningGenerationLaunchedBy")
  appliedPlanningGenerations         PlanningGeneration[]           @relation("PlanningGenerationAppliedBy")
  resolvedPlanningConflicts          PlanningConflict[]             @relation("PlanningConflictResolvedBy")
  recipientPlanningNotifications     PlanningNotification[]         @relation("PlanningNotificationRecipientUser")
  actorPlanningHistory               PlanningHistory[]              @relation("PlanningHistoryActor")
  planningExports                    PlanningExport[]               @relation("PlanningExportRequestedBy")
  createdPlanningDayStatuses         PlanningDayStatus[]            @relation("PlanningDayStatusCreatedBy")
  updatedPlanningDayStatuses         PlanningDayStatus[]            @relation("PlanningDayStatusUpdatedBy")
  createdHrTimeAccountTransactions   HrTimeAccountTransaction[]     @relation("HrTimeAccountTransactionCreatedBy")
  createdPlanningPolicies            PlanningPolicyProfile[]        @relation("PlanningPolicyProfileCreatedBy")
  signedPlanningAttendanceEntries    PlanningAttendanceEntry[]      @relation("PlanningAttendanceSignedBy")
  validatedPlanningAttendanceEntries PlanningAttendanceEntry[]      @relation("PlanningAttendanceValidatedBy")
  createdHrEntitlementRules          HrEntitlementRule[]            @relation("HrEntitlementRuleCreatedBy")
  updatedHrEntitlementRules          HrEntitlementRule[]            @relation("HrEntitlementRuleUpdatedBy")
  regulatoryCountrySelections        Organization[]                 @relation("OrganizationRegulatoryCountrySelectedBy")
  createdHrEmployeeEntitlements      HrEmployeeEntitlement[]        @relation("HrEmployeeEntitlementCreatedBy")
  createdTechnicalSheetHistory       TechnicalSheetHistory[]        @relation("TechnicalSheetHistoryActor")
  planningViewPreferences            PlanningViewPreference[]
  createdProductionOrders            ProductionOrder[]              @relation("ProductionOrderCreatedBy")
  updatedProductionOrders            ProductionOrder[]              @relation("ProductionOrderUpdatedBy")
  completedProductionOrders          ProductionOrder[]              @relation("ProductionOrderCompletedBy")
  productionAlertOverrides           ProductionAlertOverride[]      @relation("ProductionAlertOverrideConfirmedBy")
  actorProductionHistory             ProductionHistory[]            @relation("ProductionHistoryActor")
  productionExports                  ProductionExport[]             @relation("ProductionExportRequestedBy")
  createdMenus                       Menu[]                         @relation("MenuCreatedBy")
  updatedMenus                       Menu[]                         @relation("MenuUpdatedBy")
  actorMenuHistory                   MenuHistory[]                  @relation("MenuHistoryActor")
  menuExports                        MenuExport[]                   @relation("MenuExportRequestedBy")
  confirmedDestockingProposals       ProductionDestockingProposal[] @relation("ProductionDestockingConfirmedBy")
  createdHaccpProducts               HaccpProduct[]                 @relation("HaccpProductCreatedBy")
  createdHaccpTemperatureEquipment   HaccpTemperatureEquipment[]    @relation("HaccpTemperatureEquipmentCreatedBy")
  createdHaccpTemperatureReadings    HaccpTemperatureReading[]      @relation("HaccpTemperatureReadingCreatedBy")
  createdHaccpReceptions             HaccpReception[]               @relation("HaccpReceptionCreatedBy")
  createdHaccpTraceabilityItems      HaccpTraceability[]            @relation("HaccpTraceabilityCreatedBy")
  createdHaccpProcessEquipment       HaccpProcessEquipment[]        @relation("HaccpProcessEquipmentCreatedBy")
  createdHaccpProcessSessions        HaccpProcessSession[]          @relation("HaccpProcessSessionCreatedBy")
  createdHaccpOilEquipment           HaccpOilEquipment[]            @relation("HaccpOilEquipmentCreatedBy")
  createdHaccpOilSessions            HaccpOilSession[]              @relation("HaccpOilSessionCreatedBy")
  createdHaccpCleaningZones          HaccpCleaningZone[]            @relation("HaccpCleaningZoneCreatedBy")
  createdHaccpCleaningSurfaces       HaccpCleaningSurface[]         @relation("HaccpCleaningSurfaceCreatedBy")
  createdHaccpCleaningSessions       HaccpCleaningSession[]         @relation("HaccpCleaningSessionCreatedBy")
  createdHaccpCleanedSurfaces        HaccpCleanedSurface[]          @relation("HaccpCleanedSurfaceCreatedBy")
  createdHaccpProductionSessions     HaccpProductionSession[]       @relation("HaccpProductionSessionCreatedBy")
  createdHaccpDailyReports           HaccpDailyReport[]             @relation("HaccpDailyReportCreatedBy")
  assignedIotSensors                 IotSensorAssignment[]          @relation("IotSensorAssignedBy")
  actorIotSensorEvents               IotSensorEvent[]               @relation("IotSensorEventActor")
  mobilePushTokens                   MobilePushToken[]
  createdMarginReports               MarginReport[]                 @relation("MarginReportCreatedBy")
  dashboardPreferences               DashboardPreference[]
  backupCloudOAuthStates             BackupCloudOAuthState[]        @relation("BackupCloudOAuthStateUser")

  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([isPrimaryAdmin])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model DashboardPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  organizationId  String   @db.Uuid
  layout          Json
  hiddenWidgetIds String[] @default([])
  pinnedWidgetIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

