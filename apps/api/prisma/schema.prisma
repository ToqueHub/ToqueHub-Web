model ProductionOrder {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  number                String
  name                  String
  technicalSheetId      String                @db.Uuid
  productionDate        DateTime
  plannedTime           String
  status                ProductionOrderStatus @default(PLANNED)
  priority              ProductionPriority    @default(NORMAL)
  serviceId             String?               @db.Uuid
  responsibleEmployeeId String?               @db.Uuid
  plannedPortions       Decimal               @db.Decimal(12, 3)
  realizedPortions      Decimal?              @db.Decimal(12, 3)
  estimatedCost         Decimal               @default(0) @db.Decimal(12, 4)
  actualCost            Decimal?              @db.Decimal(12, 4)
  comments              String?               @db.Text
  source                String                @default("MANUAL")
  createdById           String?               @db.Uuid
  updatedById           String?               @db.Uuid
  completedById         String?               @db.Uuid
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization        Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technicalSheet      TechnicalSheet                  @relation(fields: [technicalSheetId], references: [id], onDelete: Restrict)
  service             HrDepartment?                   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  responsibleEmployee HrEmployee?                     @relation("ProductionOrderResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  createdBy           User?                           @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?                           @relation("ProductionOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completedBy         User?                           @relation("ProductionOrderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  requirements        ProductionMaterialRequirement[]
  assignments         ProductionAssignment[]
  alerts              ProductionAlert[]
  history             ProductionHistory[]
  exports             ProductionExport[]
  realization         ProductionRealization?
  destockingProposals ProductionDestockingProposal[]
  menuProductionLinks MenuProductionLink[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([technicalSheetId])
  @@index([productionDate])
  @@index([status])
  @@index([priority])
  @@index([serviceId])
  @@index([responsibleEmployeeId])
  @@map("production_orders")
}

