model Organization {
  id                         String    @id @default(uuid()) @db.Uuid
  name                       String
  code                       String?   @unique
  establishmentType          String?
  teamSize                   String?
  logoDataUrl                String?   @db.Text
  mainSiteName               String?
  stocksInstalledAt          DateTime?
  rnmPricesInstalledAt       DateTime?
  hrInstalledAt              DateTime?
  planningInstalledAt        DateTime?
  technicalSheetsInstalledAt DateTime?
  productionInstalledAt      DateTime?
  menusInstalledAt           DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  users                          User[]
  categories                     Category[]
  units                          Unit[]
  products                       Product[]
  suppliers                      Supplier[]
  sites                          Site[]
  locations                      Location[]
  lots                           Lot[]
  stocks                         Stock[]
  stockMovements                 StockMovement[]
  inventories                    Inventory[]
  auditLogs                      AuditLog[]
  rnmFavorites                   RnmProductFavorite[]
  unitConversions                UnitConversion[]
  hrDepartments                  HrDepartment[]
  hrPositions                    HrPosition[]
  employees                      HrEmployee[]
  employeeHistory                HrEmployeeHistory[]
  hrRotations                    HrRotation[]
  hrRotationAssignments          HrRotationAssignment[]
  hrAbsences                     HrAbsence[]
  hrSkills                       HrSkill[]
  planningAssignments            PlanningAssignment[]
  planningReplacements           PlanningReplacement[]
  planningNeeds                  PlanningOperationalNeed[]
  planningTemplates              PlanningTemplate[]
  planningTemplateApplications   PlanningTemplateApplication[]
  planningGenerations            PlanningGeneration[]
  planningConflicts              PlanningConflict[]
  planningNotifications          PlanningNotification[]
  planningHistory                PlanningHistory[]
  planningExports                PlanningExport[]
  recipeCategories               TechnicalSheetCategory[]
  technicalSheets                TechnicalSheet[]
  technicalSheetIngredients      TechnicalSheetIngredient[]
  technicalSheetSteps            TechnicalSheetStep[]
  technicalSheetAllergens        TechnicalSheetAllergen[]
  technicalSheetCostSnapshots    TechnicalSheetCostSnapshot[]
  technicalSheetSimulations      TechnicalSheetSimulation[]
  technicalSheetExports          TechnicalSheetExport[]
  technicalSheetHistory          TechnicalSheetHistory[]
  productionOrders               ProductionOrder[]
  productionMaterialRequirements ProductionMaterialRequirement[]
  productionAssignments          ProductionAssignment[]
  productionAlerts               ProductionAlert[]
  productionAlertOverrides       ProductionAlertOverride[]
  productionHistory              ProductionHistory[]
  productionExports              ProductionExport[]
  productionRealizations         ProductionRealization[]
  productionDestockingProposals  ProductionDestockingProposal[]
  productionDestockingLines      ProductionDestockingLine[]
  productionDestockingMovements  ProductionDestockingMovement[]
  menuDiets                      MenuDiet[]
  menus                          Menu[]
  menuItems                      MenuItem[]
  menuVariants                   MenuVariant[]
  menuGuestGroups                MenuGuestGroup[]
  menuGuestForecasts             MenuGuestForecast[]
  menuCycles                     MenuCycle[]
  menuCycleItems                 MenuCycleItem[]
  menuExports                    MenuExport[]
  menuHistory                    MenuHistory[]
  menuProductionLinks            MenuProductionLink[]
  planningViewPreferences        PlanningViewPreference[]
  dashboardPreferences            DashboardPreference[]

  @@map("organizations")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  username       String?    @unique
  email          String     @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  status         UserStatus @default(ACTIVE)
  isActive       Boolean    @default(true)
  isPrimaryAdmin Boolean    @default(false)
  lastLoginAt    DateTime?
  organizationId String?    @db.Uuid
  roleId         String     @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization                   Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                           Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  movements                      StockMovement[]                @relation("StockMovementCreatedBy")
  inventories                    Inventory[]                    @relation("InventoryCreatedBy")
  auditLogs                      AuditLog[]
  rnmFavorites                   RnmProductFavorite[]
  hrEmployee                     HrEmployee?
  hrHistory                      HrEmployeeHistory[]
  hrRotationAssignments          HrRotationAssignment[]
  validatedHrAbsences            HrAbsence[]                    @relation("HrAbsenceValidator")
  createdPlanningAssignments     PlanningAssignment[]           @relation("PlanningAssignmentCreatedBy")
  updatedPlanningAssignments     PlanningAssignment[]           @relation("PlanningAssignmentUpdatedBy")
  requestedPlanningReplacements  PlanningReplacement[]          @relation("PlanningReplacementRequestedBy")
  acceptedPlanningReplacements   PlanningReplacement[]          @relation("PlanningReplacementAcceptedBy")
  createdPlanningNeeds           PlanningOperationalNeed[]      @relation("PlanningNeedCreatedBy")
  createdPlanningTemplates       PlanningTemplate[]             @relation("PlanningTemplateCreatedBy")
  appliedPlanningTemplates       PlanningTemplateApplication[]  @relation("PlanningTemplateAppliedBy")
  launchedPlanningGenerations    PlanningGeneration[]           @relation("PlanningGenerationLaunchedBy")
  appliedPlanningGenerations     PlanningGeneration[]           @relation("PlanningGenerationAppliedBy")
  resolvedPlanningConflicts      PlanningConflict[]             @relation("PlanningConflictResolvedBy")
  recipientPlanningNotifications PlanningNotification[]         @relation("PlanningNotificationRecipientUser")
  actorPlanningHistory           PlanningHistory[]              @relation("PlanningHistoryActor")
  planningExports                PlanningExport[]               @relation("PlanningExportRequestedBy")
  createdTechnicalSheetHistory   TechnicalSheetHistory[]        @relation("TechnicalSheetHistoryActor")
  planningViewPreferences        PlanningViewPreference[]
  createdProductionOrders        ProductionOrder[]              @relation("ProductionOrderCreatedBy")
  updatedProductionOrders        ProductionOrder[]              @relation("ProductionOrderUpdatedBy")
  completedProductionOrders      ProductionOrder[]              @relation("ProductionOrderCompletedBy")
  productionAlertOverrides       ProductionAlertOverride[]      @relation("ProductionAlertOverrideConfirmedBy")
  actorProductionHistory         ProductionHistory[]            @relation("ProductionHistoryActor")
  productionExports              ProductionExport[]             @relation("ProductionExportRequestedBy")
  createdMenus                   Menu[]                         @relation("MenuCreatedBy")
  updatedMenus                   Menu[]                         @relation("MenuUpdatedBy")
  actorMenuHistory               MenuHistory[]                  @relation("MenuHistoryActor")
  menuExports                    MenuExport[]                   @relation("MenuExportRequestedBy")
  confirmedDestockingProposals   ProductionDestockingProposal[] @relation("ProductionDestockingConfirmedBy")
  dashboardPreferences          DashboardPreference[]

  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([isPrimaryAdmin])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model DashboardPreference {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  layout         Json
  hiddenWidgetIds String[] @default([])
  pinnedWidgetIds String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("dashboard_preferences")
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  organizationId String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isArchived])
  @@map("categories")
}

model Unit {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  symbol         String
  type           UnitType  @default(OTHER)
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  organizationId String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products                       Product[]
  movements                      StockMovement[]
  fromConversions                UnitConversion[]                @relation("UnitConversionFrom")
  toConversions                  UnitConversion[]                @relation("UnitConversionTo")
  technicalSheetIngredients      TechnicalSheetIngredient[]
  productionMaterialRequirements ProductionMaterialRequirement[]
  productionDestockingLines      ProductionDestockingLine[]

  @@unique([organizationId, symbol])
  @@index([organizationId])
  @@index([isArchived])
  @@map("units")
}

model UnitConversion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  fromUnitId     String   @db.Uuid
  toUnitId       String   @db.Uuid
  factor         Decimal  @db.Decimal(18, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUnit     Unit         @relation("UnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit       Unit         @relation("UnitConversionTo", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromUnitId, toUnitId])
  @@index([organizationId])
  @@map("unit_conversions")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  sku               String?
  description       String?
  averagePrice      Decimal   @default(0) @db.Decimal(12, 4)
  minimumStock      Decimal   @default(0) @db.Decimal(12, 3)
  isArchived        Boolean   @default(false)
  archivedAt        DateTime?
  organizationId    String    @db.Uuid
  categoryId        String?   @db.Uuid
  unitId            String    @db.Uuid
  primarySupplierId String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization              Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                  Category?                       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit                      Unit                            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  primarySupplier           Supplier?                       @relation("ProductPrimarySupplier", fields: [primarySupplierId], references: [id], onDelete: SetNull)
  stocks                    Stock[]
  movements                 StockMovement[]
  lots                      Lot[]
  technicalSheetIngredients TechnicalSheetIngredient[]
  inventoryLines            InventoryLine[]
  productionRequirements    ProductionMaterialRequirement[]
  productionDestockingLines ProductionDestockingLine[]

  @@unique([organizationId, name])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@index([unitId])
  @@index([primarySupplierId])
  @@index([isArchived])
  @@map("products")
}

model Supplier {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?   @db.Text
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  organizationId String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lots                   Lot[]
  movements              StockMovement[]
  productionRequirements ProductionMaterialRequirement[]
  primaryProducts        Product[]                       @relation("ProductPrimarySupplier")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isArchived])
  @@map("suppliers")
}

model Site {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  organizationId String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization                 Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations                    Location[]
  stocks                       Stock[]
  lots                         Lot[]
  sourceMovements              StockMovement[]               @relation("StockMovementSourceSite")
  destinationMovements         StockMovement[]               @relation("StockMovementDestinationSite")
  inventories                  Inventory[]
  employees                    HrEmployee[]
  planningAssignments          PlanningAssignment[]
  planningNeeds                PlanningOperationalNeed[]
  planningTemplates            PlanningTemplate[]
  planningTemplateApplications PlanningTemplateApplication[]
  planningGenerations          PlanningGeneration[]
  planningExports              PlanningExport[]
  menus                        Menu[]
  menuCycles                   MenuCycle[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isArchived])
  @@map("sites")
}

model Location {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  organizationId String    @db.Uuid
  siteId         String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                 Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  stocks               Stock[]
  lots                 Lot[]
  sourceMovements      StockMovement[] @relation("StockMovementSourceLocation")
  destinationMovements StockMovement[] @relation("StockMovementDestinationLocation")
  inventories          Inventory[]

  @@unique([organizationId, siteId, name])
  @@index([organizationId])
  @@index([siteId])
  @@index([isArchived])
  @@map("locations")
}

model Lot {
  id             String    @id @default(uuid()) @db.Uuid
  lotNumber      String
  productId      String    @db.Uuid
  supplierId     String?   @db.Uuid
  organizationId String    @db.Uuid
  receivedAt     DateTime  @default(now())
  expiresAt      DateTime?
  siteId         String?   @db.Uuid
  locationId     String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  site         Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location     Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stocks       Stock[]
  movements    StockMovement[]

  @@unique([organizationId, lotNumber, productId])
  @@index([organizationId])
  @@index([productId])
  @@index([supplierId])
  @@index([siteId])
  @@index([locationId])
  @@map("lots")
}

model Stock {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  lotId          String?  @db.Uuid
  siteId         String?  @db.Uuid
  locationId     String?  @db.Uuid
  quantity       Decimal  @db.Decimal(12, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot          Lot?         @relation(fields: [lotId], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, productId, lotId, siteId, locationId])
  @@index([organizationId])
  @@index([productId])
  @@index([lotId])
  @@index([siteId])
  @@index([locationId])
  @@map("stocks")
}

model StockMovement {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @db.Uuid
  productId             String            @db.Uuid
  lotId                 String?           @db.Uuid
  supplierId            String?           @db.Uuid
  type                  StockMovementType
  quantity              Decimal           @db.Decimal(12, 3)
  inputQuantity         Decimal?          @db.Decimal(12, 3)
  unitId                String?           @db.Uuid
  unitSymbolSnapshot    String?
  reason                String?
  sourceSiteId          String?           @db.Uuid
  sourceLocationId      String?           @db.Uuid
  destinationSiteId     String?           @db.Uuid
  destinationLocationId String?           @db.Uuid
  movementDate          DateTime          @default(now())
  createdById           String?           @db.Uuid
  inventoryId           String?           @db.Uuid
  createdAt             DateTime          @default(now())

  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product                       Product                        @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot                           Lot?                           @relation(fields: [lotId], references: [id], onDelete: SetNull)
  supplier                      Supplier?                      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  unit                          Unit?                          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sourceSite                    Site?                          @relation("StockMovementSourceSite", fields: [sourceSiteId], references: [id], onDelete: SetNull)
  sourceLocation                Location?                      @relation("StockMovementSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationSite               Site?                          @relation("StockMovementDestinationSite", fields: [destinationSiteId], references: [id], onDelete: SetNull)
  destinationLocation           Location?                      @relation("StockMovementDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  createdBy                     User?                          @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  inventory                     Inventory?                     @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  productionDestockingMovements ProductionDestockingMovement[]

  @@index([organizationId])
  @@index([productId])
  @@index([lotId])
  @@index([supplierId])
  @@index([sourceSiteId])
