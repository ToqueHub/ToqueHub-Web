  hrCountryCode                 String?
  regulatoryCountryCode         String?
  regulatorySector              String?
  regulatoryCountrySelectedAt   DateTime?
  regulatoryCountrySelectedById String?   @db.Uuid
  teamSize                      String?
  logoDataUrl                   String?   @db.Text
  mainSiteName                  String?
  primarySiteId                 String?   @db.Uuid
  stocksInstalledAt             DateTime?
  rnmPricesInstalledAt          DateTime?
  hrInstalledAt                 DateTime?
  planningInstalledAt           DateTime?
  technicalSheetsInstalledAt    DateTime?
  productionInstalledAt         DateTime?
  menusInstalledAt              DateTime?
  haccpInstalledAt              DateTime?
  mistralApiKey                 String?   @db.Text
  mistralApiKeyUpdatedAt        DateTime?
  githubToken                   String?   @db.Text
  githubTokenUpdatedAt          DateTime?
  tailscaleEnabled              Boolean   @default(false)
  tailscaleHostname             String?
  tailscaleUrl                  String?   @db.Text
  tailscaleIp                   String?
