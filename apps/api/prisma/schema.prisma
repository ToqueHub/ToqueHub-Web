  units                           Unit[]
  products                        Product[]
  suppliers                       Supplier[]
  sites                           Site[]                           @relation("OrganizationSites")
  locations                       Location[]
  lots                            Lot[]
  stocks                          Stock[]
  stockMovements                  StockMovement[]
  documents                       Document[]
  ocrDocuments                    OcrDocument[]
  ocrBusinessExtractions          OcrBusinessExtraction[]
  stockReceptions                 StockReception[]
  marginSettings                  MarginSettings?
  marginAlerts                    MarginAlert[]
  marginReports                   MarginReport[]
  inventories                     Inventory[]
  auditLogs                       AuditLog[]
  rnmFavorites                    RnmProductFavorite[]
  unitConversions                 UnitConversion[]
  hrDepartments                   HrDepartment[]
  hrPositions                     HrPosition[]
  employees                       HrEmployee[]
  employeeHistory                 HrEmployeeHistory[]
  hrOnboardingProgress            HrOnboardingProgress?
  hrEmploymentContracts           HrEmploymentContract[]
  hrDocuments                     HrDocument[]
  hrRotations                     HrRotation[]
  hrRotationAssignments           HrRotationAssignment[]
  hrAbsences                      HrAbsence[]
  hrSkills                        HrSkill[]
  planningAssignments             PlanningAssignment[]
  planningReplacements            PlanningReplacement[]
  planningNeeds                   PlanningOperationalNeed[]
  planningTemplates               PlanningTemplate[]
  planningTemplateApplications    PlanningTemplateApplication[]
  planningGenerations             PlanningGeneration[]
  planningConflicts               PlanningConflict[]
  planningNotifications           PlanningNotification[]
  planningHistory                 PlanningHistory[]
  planningExports                 PlanningExport[]
  planningDayStatuses             PlanningDayStatus[]
  planningCodeDictionary          PlanningCodeDictionary[]
  planningPolicyProfiles          PlanningPolicyProfile[]
