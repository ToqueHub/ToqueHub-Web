}

model MenuVariantReplacement {
  id                         String   @id @default(uuid()) @db.Uuid
  variantId                  String   @db.Uuid
  menuItemId                 String?  @db.Uuid
  section                    MenuSectionType?
  replacementTechnicalSheetId String  @db.Uuid
  position                   Int      @default(0)
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now())

  variant                  MenuVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  menuItem                 MenuItem?      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  replacementTechnicalSheet TechnicalSheet @relation(fields: [replacementTechnicalSheetId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@index([menuItemId])
  @@index([replacementTechnicalSheetId])
  @@map("menu_variant_replacements")
}

model MenuGuestGroup {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String
  type           MenuGuestGroupType @default(OTHER)
  description    String?            @db.Text
  isArchived     Boolean            @default(false)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  forecasts    MenuGuestForecast[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isArchived])
  @@map("menu_guest_groups")
}

model MenuGuestForecast {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  menuId         String   @db.Uuid
  guestGroupId   String   @db.Uuid
  dietId         String?  @db.Uuid
  count          Int
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  guestGroup   MenuGuestGroup @relation(fields: [guestGroupId], references: [id], onDelete: Restrict)
  diet         MenuDiet?    @relation(fields: [dietId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([menuId])
  @@index([guestGroupId])
  @@index([dietId])
  @@map("menu_guest_forecasts")
}

model MenuCycle {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  description    String?         @db.Text
  durationWeeks  Int
  siteId         String?         @db.Uuid
  status         MenuCycleStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  items        MenuCycleItem[]
  menus        Menu[]
  history      MenuHistory[]

  @@index([organizationId])
  @@index([siteId])
  @@index([status])
  @@map("menu_cycles")
}

model MenuCycleItem {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  cycleId          String          @db.Uuid
  weekNumber       Int
  dayOfWeek        Int
  service          MenuServiceType
  section          MenuSectionType
  technicalSheetId String          @db.Uuid
  position         Int             @default(0)
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle          MenuCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  technicalSheet TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([cycleId])
  @@index([technicalSheetId])
  @@index([weekNumber, dayOfWeek, service])
  @@map("menu_cycle_items")
}

model MenuProductionLink {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  menuId            String   @db.Uuid
  productionOrderId String   @db.Uuid
  generationMode    MenuProductionGenerationMode
  snapshot          Json?
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu            Menu            @relation(fields: [menuId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  @@unique([menuId, productionOrderId])
  @@index([organizationId])
  @@index([productionOrderId])
  @@map("menu_production_links")
}

model MenuExport {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  menuId         String?            @db.Uuid
  requestedById  String?            @db.Uuid
  format         MenuExportFormat
  audience       MenuExportAudience
  filename       String
  filters        Json?
  snapshot       Json
  fileUrl        String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu         Menu?        @relation(fields: [menuId], references: [id], onDelete: SetNull)
  requestedBy  User?        @relation("MenuExportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([menuId])
  @@index([requestedById])
  @@index([format])
  @@index([audience])
  @@map("menu_exports")
}

model MenuHistory {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  menuId         String?           @db.Uuid
  cycleId        String?           @db.Uuid
  actorUserId    String?           @db.Uuid
  action         MenuHistoryAction
  summary        String
  details        Json?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu         Menu?        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  cycle        MenuCycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation("MenuHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([menuId])
  @@index([cycleId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("menu_history")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  userId         String?     @db.Uuid
  action         AuditAction
  entityType     String
  entityId       String?
  entityName     String?
  details        Json?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
