{
  "name": "@toquehub/api",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nest build",
    "start": "node dist/main.js",
    "start:dev": "NODE_OPTIONS=--max-old-space-size=4096 nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 jest",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --skip-seed",
    "prisma:seed": "node --env-file=../../.env --import tsx prisma/seed.ts",
    "seed:legal-rights": "node --env-file=../../.env --import tsx scripts/seed-legal-rights.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.2",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "bonjour-service": "^1.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "mqtt": "^5.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.4.2",
    "prisma": "^6.8.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.4"
  }
}
