TOQUEHUB_RELEASE_REPO=ToqueHub/ToqueHub-Web
TOQUEHUB_GITHUB_TOKEN=
TOQUEHUB_IMAGE_REGISTRY=ghcr.io/toquehub
TOQUEHUB_IMAGE_TAG=latest
TOQUEHUB_INSTALL_DIR=/opt/toquehub
TOQUEHUB_DATA_DIR=/var/lib/toquehub
TOQUEHUB_CONFIG_DIR=/etc/toquehub

POSTGRES_DB=toquehub
POSTGRES_USER=toquehub
POSTGRES_PASSWORD=replace-with-generated-secret

JWT_SECRET=replace-with-generated-secret
JWT_EXPIRES_IN=8h
BACKUP_CLOUD_ENCRYPTION_KEY=replace-with-generated-secret
PURCHASING_RESEND_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret
PURCHASING_EMAIL_ENCRYPTION_KEY=replace-with-a-32-byte-minimum-random-secret
HR_SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-generated-secret
FINANCE_SECRETS_ENCRYPTION_KEY=replace-with-generated-secret
# Optional: normally detected from the URL opened by the super-admin.
PUBLIC_APP_URL=
TOQUEHUB_SUPPORT_RELAY_URL=https://toquehub-support-relay.fly.dev
TOQUEHUB_UPDATER_SECRET=replace-with-generated-secret
TOQUEHUB_REMOTE_AGENT_SECRET=replace-with-generated-secret
TOQUEHUB_REMOTE_AGENT_URL=http://host.docker.internal:3101

TOQUEHUB_HTTP_PORT=80
TOQUEHUB_LOCAL_HOSTNAME=toquehub-pi
TOQUEHUB_WEB_URL=http://toquehub-pi.local
ZIGBEE2MQTT_HTTP_PORT=8081
MQTT_PORT=1883
TZ=Europe/Paris

TOQUEHUB_TAILSCALE_ENABLED=true
TOQUEHUB_TAILSCALE_AUTHKEY=
TOQUEHUB_TAILSCALE_HOSTNAME=toquehub
TOQUEHUB_TAILSCALE_INSTALLED=false
TOQUEHUB_TAILSCALE_IP=
TOQUEHUB_TAILSCALE_DNS_NAME=
TOQUEHUB_REMOTE_ACCESS_URL=

TOQUEHUB_DISCOVERY_ENABLED=true
TOQUEHUB_DISCOVERY_NAME=ToqueHub
TOQUEHUB_DISCOVERY_ORGANIZATION=ToqueHub
TOQUEHUB_DISCOVERY_HOST=
TOQUEHUB_DISCOVERY_PORT=80
TOQUEHUB_DISCOVERY_HTTPS=false

MQTT_USERNAME=
MQTT_PASSWORD=
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
ZIGBEE2MQTT_FRONTEND_URL=http://toquehub-pi.local:8081
ZIGBEE_ADAPTER_PATH=
ZIGBEE_ADAPTER_TYPE=
ZIGBEE2MQTT_TAG=latest

HACCP_SENSOR_OFFLINE_AFTER_MINUTES=30
HACCP_PAIRING_DURATION_SECONDS=180
