DATABASE_URL="postgresql://toquehub:toquehub@localhost:5432/toquehub?schema=public"
JWT_SECRET="change-me-in-development"
JWT_EXPIRES_IN="8h"
VITE_API_URL="http://localhost:3000"
BACKUP_CLOUD_ENCRYPTION_KEY="replace-with-a-32-byte-minimum-random-secret"
PURCHASING_RESEND_ENCRYPTION_KEY="replace-with-a-dedicated-random-secret"
PURCHASING_EMAIL_ENCRYPTION_KEY="replace-with-a-32-byte-minimum-random-secret"
HR_SENSITIVE_DATA_ENCRYPTION_KEY="replace-with-a-dedicated-32-byte-minimum-random-secret"
OCR_TIMEOUT_MS="120000"
FINANCE_SECRETS_ENCRYPTION_KEY="replace-with-a-dedicated-32-byte-minimum-random-secret"
# Dossier où Flatpay ou votre messagerie dépose les rapports exportés.
FLATPAY_REPORTS_INBOX="/absolute/path/to/flatpay-reports"
# Ignore les fichiers encore en cours de téléchargement pendant ce délai.
FLATPAY_REPORT_SETTLE_SECONDS="60"
# Requis uniquement lorsqu’une instance héberge plusieurs organisations.
FLATPAY_ORGANIZATION_ID=""
# Robot du portail : le secret configuré dans Finance est conservé dans le trousseau macOS
# ou chiffré localement avec FINANCE_SECRETS_ENCRYPTION_KEY sous Windows et Linux.
FLATPAY_PORTAL_URL="https://portal.flatpay.com/"
# Facultatif : Chrome/Edge/Chromium est détecté automatiquement sur macOS, Windows et Linux.
# Sur Raspberry Pi : /usr/bin/chromium
FLATPAY_CHROME_PATH=""
FLATPAY_BROWSER_PROFILE_DIR="/absolute/path/to/private/flatpay-browser-profile"
FLATPAY_AUTOMATION_STATE_PATH="/absolute/path/to/private/flatpay-state.json"
# Premier jour à récupérer. Orders et transactions sont découpés en petits lots
# pour ne jamais dépendre de la limite Flatpay de 500 lignes affichées.
FLATPAY_HISTORY_START=""
# Orders et Sales Overview sont toujours ajoutés, même s'ils sont omis ici.
FLATPAY_REPORT_TYPES="orders,sales-overview,turnover,transactions"
FLATPAY_ORDER_CHUNK_DAYS="1"
FLATPAY_PRODUCT_CHUNK_DAYS="1"
FLATPAY_TRANSACTION_CHUNK_DAYS="1"
# Évite de saturer Flatpay pendant une reprise historique ; les exécutions suivantes reprennent automatiquement.
FLATPAY_MAX_GENERATIONS_PER_RUN="20"
# Optional override for Google/Microsoft OAuth callbacks. Normally detected automatically.
PUBLIC_APP_URL=""
# Optional for hosted deployments. Self-hosted instances can configure OAuth once from Achats.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_TENANT_ID="common"
# Adresse du relais central de support Kokki. Laisser la valeur par défaut en production.
TOQUEHUB_SUPPORT_RELAY_URL="https://toquehub-support-relay.fly.dev"
PG_DUMP_PATH="/absolute/path/to/scripts/pg_dump_docker.sh"
PG_RESTORE_PATH="/absolute/path/to/scripts/pg_restore_docker.sh"
TOQUEHUB_DISCOVERY_ENABLED="true"
TOQUEHUB_DISCOVERY_NAME="Cuisine Centrale"
TOQUEHUB_DISCOVERY_ORGANIZATION="Cuisine Centrale"
TOQUEHUB_DISCOVERY_HOST=""
TOQUEHUB_DISCOVERY_PORT="8080"
TOQUEHUB_DISCOVERY_HTTPS="false"
TOQUEHUB_RELEASE_REPO="ToqueHub/ToqueHub-Web"
TOQUEHUB_GITHUB_TOKEN=""
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
ZIGBEE2MQTT_BASE_TOPIC="zigbee2mqtt"
ZIGBEE2MQTT_FRONTEND_URL="http://localhost:8080"
ZIGBEE_ADAPTER_PATH="/dev/ttyUSB0"
HACCP_SENSOR_OFFLINE_AFTER_MINUTES="30"
HACCP_PAIRING_DURATION_SECONDS="180"
